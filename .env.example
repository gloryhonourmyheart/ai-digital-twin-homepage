# ======== 后端 API Key 配置（永远不要提交到 Git！）========
# 将此文件复制为 .env 并填入真实值
# 服务器会读取 .env，前端看不到你的 Key

# 你的 AI 服务商 API Key（从对应平台控制台复制）
LLM_API_KEY=sk-dccc7660dd08431e9e48e2eaa720dd2f

# （可选）自定义 API 端点，留空默认用 DeepSeek
# 示例（阿里云 DashScope）: https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# LLM_ENDPOINT=

# （可选）自定义模型，留空默认用 deepseek-chat
# LLM_MODEL=deepseek-chat
